# Server Configuration
PORT=5000
# JWT_SECRET is required and must be at least 32 characters long.
# The server refuses to start if JWT_SECRET is missing or shorter than 32 characters.
JWT_SECRET=satya_shield_jwt_super_secure_secret_sih_2026

# Demo Mode Configuration
# When false (default), all verification decisions depend strictly on real image pixel analysis.
# When true, bundled specimens in assets/specimens/ matching exact SHA-256 return documented demo outcomes.
DEMO_MODE=false

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT_MS=45000
