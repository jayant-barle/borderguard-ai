{
  "name": "borderguard-ai",
  "version": "2.4.0",
  "description": "AI-Powered Identity & Document Screening for Faster, Safer Verification",
  "main": "server/src/index.ts",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx server/src/index.ts",
    "client:dev": "npm run --prefix client dev",
    "client:build": "npm run --prefix client build",
    "build": "npm run client:build",
    "start": "tsx server/src/index.ts",
    "test:pipeline": "tsx server/src/tests/pipeline.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "isomorphic-git": "^1.41.9",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
